<script>!function(n){if(!window[n]){var o=window[n]=function(){var n=[].slice.call(arguments);return o.x?o.x.apply(0,n):o.q.push(n)};o.q=[],o.i=Date.now(),o.allow=function(){o.o="allow"},o.deny=function(){o.o="deny"}}}("krt")</script><script async src="https://cdn-edge.karte.io/fb95480c79d2c02e5cbf91aeeda7943e/edge.js"></script>
<script type="application/ld+json">{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "@id": "https://www.meetcareer.net/#faq",
  "url": "https://www.meetcareer.net/",
  "isPartOf": {"@id": "https://www.meetcareer.net/#webpage"},
  "inLanguage": "ja",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "ミートキャリアと転職エージェントの違いは何ですか？",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "転職エージェントは転職先の紹介が主なサービスですが、ミートキャリアは転職を前提としないキャリア支援サービスです。自己分析や強みの発見、キャリアプランの策定など、あなた自身の理解を深めることに重点を置いています。転職するかしないかも含めて、納得のいくキャリア選択ができるようサポートします。"
      }
    },
    {
      "@type": "Question",
      "name": "どんな人が利用していますか？",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "30代から40代の働く女性が中心です。子育てと仕事の両立に悩んでいる方、転職すべきか迷っている方、自分の強みがわからない方、キャリアの方向性を整理したい方など、キャリアにモヤモヤを感じている方にご利用いただいています。6,000件以上の有料キャリア支援実績があります。"
      }
    },
    {
      "@type": "Question",
      "name": "オンラインで相談できますか？",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "はい、ミートキャリアのサービスは全てオンラインで完結します。全国どこからでも、ご自宅からキャリア相談やセッションを受けることができます。"
      }
    },
    {
      "@type": "Question",
      "name": "無料相談会では何ができますか？",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "無料相談会では、約50分間のオンラインカウンセリングを通じて、キャリアのモヤモヤや不安の整理、自分の強みや価値観の発見、今後のキャリアの方向性の確認ができます。その後、ミートキャリアのサービス内容についてご説明します。無理な勧誘は一切行っておりません。"
      }
    },
    {
      "@type": "Question",
      "name": "どのようなコースがありますか？",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "キャリアプランニングコース（中長期のキャリア設計）、転職対策コース（応募書類や面接対策）、育休メンター（育休中のパパやママ向けキャリア伴走サポート）の3つのサービスがあります。目標達成に伴走する専任のキャリアトレーナーによるマンツーマンのサポートを受けられます。"
      }
    },
    {
      "@type": "Question",
      "name": "キャリアトレーナーとはどのような方ですか？",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "ミートキャリアのキャリアトレーナーは全員が国家資格キャリアコンサルタントを保有しています。子育てや転職の経験を持つトレーナーも多く、原体験も活かしながらあなたの強みやあなたらしさを引き出す伴走支援を行います。"
      }
    }
  ]
}</script>
<link href="https://magazine.meetcareer.net/feed/" rel="alternate" title="ミーキャリマガジン - フィード" type="application/rss+xml">
</head>
<body>
<div class="box sd-1"><header class="box symbol-1" data-scope-1><div class="box symbol-1__sd-1"><a class="box symbol-1__sd-2" href="/" data-current><img class="img symbol-1__sd-3" width="214" height="40" alt="" src="https://storage.googleapis.com/studio-design-asset-files/projects/65qmDLXROV/s-214x40_3b3fc86b-5f8e-4c29-a84f-f9c0958dcdf6.svg" loading="lazy" /></a><nav class="box symbol-1__sd-4"><a class="text symbol-1__sd-5" href="/beginners">はじめての方へ</a><div class="box symbol-1__sd-6"></div><a class="text symbol-1__sd-7" href="/method">選ばれる理由<br></a><div class="box symbol-1__sd-8"></div><a class="text symbol-1__sd-9" href="/service">サービス概要</a><div class="box symbol-1__sd-10"></div><a class="text symbol-1__sd-11" href="https://www.meetcareer.net/ikukyu" target="_blank">育休メンター</a><div class="box symbol-1__sd-12"></div><a class="text symbol-1__sd-13" href="/members">トレーナー紹介</a><div class="box symbol-1__sd-14"></div><a class="text symbol-1__sd-15" href="/voice">受講生の声</a><a class="text symbol-1__sd-16" href="/counseling">無料相談会予約</a><a class="text symbol-1__sd-17 theme-86bc47f7" href="/counseling" target="_blank">無料相談会予約</a><a class="text symbol-1__sd-18 theme-86bc47f7" href="https://work.meetcareer.net/" target="_blank">気軽に3分ワーク</a></nav><button class="box symbol-1__sd-19" data-modal="modal-menu" onclick="showModal(&quot;modal-menu&quot;,this)" type="button"><div class="box symbol-1__sd-20"></div><div class="box symbol-1__sd-21"></div><div class="box symbol-1__sd-22"></div></button></div></header><main class="box sd-2"><div class="box sd-3" id="fv"><div class="box image image--horizontal sd-4" style="--img-origin:url(https://storage.googleapis.com/studio-design-asset-files/projects/65qmDLXROV/s-2048x1216_v-frms_webp_53b5799d-175d-408a-9927-f1a2e385a6e8.webp);--img-small:url(https://storage.googleapis.com/studio-design-asset-files/projects/65qmDLXROV/s-2048x1216_v-frms_webp_53b5799d-175d-408a-9927-f1a2e385a6e8_small.webp);--img-middle:url(https://storage.googleapis.com/studio-design-asset-files/projects/65qmDLXROV/s-2048x1216_v-frms_webp_53b5799d-175d-408a-9927-f1a2e385a6e8_middle.webp);--img-regular:url(https://storage.googleapis.com/studio-design-asset-files/projects/65qmDLXROV/s-2048x1216_v-frms_webp_53b5799d-175d-408a-9927-f1a2e385a6e8_regular.webp)"><span class="image__bg-container" aria-hidden="true"></span><div class="box sd-5"><div class="box sd-6 appear"><div class="box sd-7"><div class="box image image--horizontal sd-8" style="--img-origin:url(https://storage.googleapis.com/studio-design-asset-files/projects/65qmDLXROV/s-240x180_webp_e7421a99-c4b0-42ff-a349-07f003db1a90.webp);--img-small:url(https://storage.googleapis.com/studio-design-asset-files/projects/65qmDLXROV/s-240x180_webp_e7421a99-c4b0-42ff-a349-07f003db1a90.webp);--img-middle:url(https://storage.googleapis.com/studio-design-asset-files/projects/65qmDLXROV/s-240x180_webp_e7421a99-c4b0-42ff-a349-07f003db1a90.webp);--img-regular:url(https://storage.googleapis.com/studio-design-asset-files/projects/65qmDLXROV/s-240x180_webp_e7421a99-c4b0-42ff-a349-07f003db1a90.webp)"><span class="image__bg-container" aria-hidden="true"></span><div class="box sd-9"><p class="text sd-10">94</p><p class="text sd-11">%</p></div><p class="text sd-12">サポート<br>満足度</p><p class="text sd-13">※1</p></div><div class="box image image--horizontal sd-14" style="--img-origin:url(https://storage.googleapis.com/studio-design-asset-files/projects/65qmDLXROV/s-240x180_webp_e7421a99-c4b0-42ff-a349-07f003db1a90.webp);--img-small:url(https://storage.googleapis.com/studio-design-asset-files/projects/65qmDLXROV/s-240x180_webp_e7421a99-c4b0-42ff-a349-07f003db1a90.webp);--img-middle:url(https://storage.googleapis.com/studio-design-asset-files/projects/65qmDLXROV/s-240x180_webp_e7421a99-c4b0-42ff-a349-07f003db1a90.webp);--img-regular:url(https://storage.googleapis.com/studio-design-asset-files/projects/65qmDLXROV/s-240x180_webp_e7421a99-c4b0-42ff-a349-07f003db1a90.webp)"><span class="image__bg-container" aria-hidden="true"></span><div class="box sd-15"><p class="text sd-16">6,000</p><p class="text sd-17">件</p></div><p class="text sd-18">カウンセリング実績</p><p class="text sd-19">※2</p></div></div></div><div class="box sd-20 appear"><div class="box sd-21"><h1 class="text sd-22 theme-4ca1d8b0">転職を前提としない</h1><h1 class="text sd-23 theme-4ca1d8b0">キャリアコーチング</h1></div><div class="box sd-24"><h3 class="text sd-25">\ 利用者の80%が女性 /</h3><p class="text sd-26">ミートキャリアは、30-40代の6,000件以上のリアルなお悩み相談から生まれたキャリアコーチングサービスです。</p></div></div></div></div><div class="box sd-27"><p class="text sd-28">※1：2023年2月~10月に利用者に実施した227回のセッションのうち、大変満足/満足と回答した人の割合<br>※2：2019年11月~2022年10月の間に提供した有料キャリアカウンセリングの件数</p></div></div><div class="box sd-29" id="method"><div class="box sd-30"><div class="box sd-31"><div class="box sd-32"><div class="box sd-33"><h2 class="text sd-34 theme-dcb91420">ミートキャリアは<br>自分らしく”はたらく”をかなえる<br>キャリアパートナーです</h2><p class="text sd-35 theme-429a329a">「もっと自分らしく働きたい」<br>そんな想いに、寄り添い、言葉にし、一緒に未来を描く。そんなキャリア支援を私たちは届けたいと思っています。ライフもキャリアも大切にしたいあなたのための'今'からの一歩を支えます。</p><a class="box sd-36" href="/method"><p class="text sd-37 theme-86bc47f7">ミートキャリアが選ばれる理由</p><span class="icon sd-38 material-icons">keyboard_arrow_right</span></a></div></div><div class="box sd-39"><div class="box image image--horizontal sd-40" style="--img-origin:url(https://storage.googleapis.com/studio-design-asset-files/projects/65qmDLXROV/s-1260x840_v-fms_webp_5b1f1da7-dbec-45a2-b402-16d8db6165c6.webp);--img-small:url(https://storage.googleapis.com/studio-design-asset-files/projects/65qmDLXROV/s-1260x840_v-fms_webp_5b1f1da7-dbec-45a2-b402-16d8db6165c6_small.webp);--img-middle:url(https://storage.googleapis.com/studio-design-asset-files/projects/65qmDLXROV/s-1260x840_v-fms_webp_5b1f1da7-dbec-45a2-b402-16d8db6165c6_middle.webp);--img-regular:url(https://storage.googleapis.com/studio-design-asset-files/projects/65qmDLXROV/s-1260x840_v-fms_webp_5b1f1da7-dbec-45a2-b402-16d8db6165c6.webp)"><span class="image__bg-container" aria-hidden="true"></span></div></div></div></div></div><div class="box sd-41" id="goal"><div class="box sd-42"><div class="box sd-43"><h4 class="text sd-44 theme-79b58953">GOAL</h4><h2 class="text sd-45 theme-dcb91420">ミートキャリアで叶える<br>「 自分らしい働き方 」</h2></div><div class="box sd-46"><div class="box sd-47"><div class="box sd-48"><div class="box sd-49"><div class="box sd-50"><div class="box sd-51"><img class="img sd-52" width="520" height="520" src="data:image/svg+xml;utf8,&lt;svg xmlns=&#x27;http://www.w3.org/2000/svg&#x27; width=&#x27;520&#x27; height=&#x27;520&#x27; viewBox=&#x27;0 0 520 520&#x27;&gt;&lt;/svg&gt;" data-sd-img="" data-sd-img-src="https://storage.googleapis.com/studio-design-asset-files/projects/65qmDLXROV/s-520x520_webp_02f0e98c-56d7-4084-ae83-140a4904fba7.png" data-sd-img-w="520" data-sd-img-h="520" data-sd-img-v="" data-sd-img-webp="" alt="" /><noscript class=""><img class="img sd-52" src="https://storage.googleapis.com/studio-design-asset-files/projects/65qmDLXROV/s-520x520_webp_02f0e98c-56d7-4084-ae83-140a4904fba7.webp" alt="" width="520" height="520" loading="lazy" /></noscript></div><h3 class="text sd-53 theme-5286a3a1">強みを活かしてイキイキ働ける</h3></div><p class="text sd-54 theme-429a329a">自分の得意や価値観を明確にし、やりがいを感じられる仕事に活かします。<br>"らしさ"を発揮しながら自信を持って働ける未来を目指します。</p></div></div><div class="box sd-55"><div class="box sd-56"><div class="box sd-57"><div class="box sd-58"><img class="img sd-59" width="520" height="520" src="data:image/svg+xml;utf8,&lt;svg xmlns=&#x27;http://www.w3.org/2000/svg&#x27; width=&#x27;520&#x27; height=&#x27;520&#x27; viewBox=&#x27;0 0 520 520&#x27;&gt;&lt;/svg&gt;" data-sd-img="" data-sd-img-src="https://storage.googleapis.com/studio-design-asset-files/projects/65qmDLXROV/s-520x520_webp_b4440fe4-d892-443a-be51-ce5e25b93d3f.png" data-sd-img-w="520" data-sd-img-h="520" data-sd-img-v="" data-sd-img-webp="" alt="" /><noscript class=""><img class="img sd-59" src="https://storage.googleapis.com/studio-design-asset-files/projects/65qmDLXROV/s-520x520_webp_b4440fe4-d892-443a-be51-ce5e25b93d3f.webp" alt="" width="520" height="520" loading="lazy" /></noscript></div><h3 class="text sd-60 theme-5286a3a1">納得感のあるキャリアの選択ができる</h3></div><p class="text sd-61 theme-429a329a">転職・副業・現職継続など、自分に合ったキャリアの方向性を選べます。<br>豊富なキャリア支援の実績から、未経験転職や内定獲得を着実に後押しします。<br></p></div></div><div class="box sd-62"><div class="box sd-63"><div class="box sd-64"><div class="box sd-65"><img class="img sd-66" width="520" height="520" src="data:image/svg+xml;utf8,&lt;svg xmlns=&#x27;http://www.w3.org/2000/svg&#x27; width=&#x27;520&#x27; height=&#x27;520&#x27; viewBox=&#x27;0 0 520 520&#x27;&gt;&lt;/svg&gt;" data-sd-img="" data-sd-img-src="https://storage.googleapis.com/studio-design-asset-files/projects/65qmDLXROV/s-520x520_webp_5e042ebf-bd2c-43a6-826a-caa22d852c23.png" data-sd-img-w="520" data-sd-img-h="520" data-sd-img-v="" data-sd-img-webp="" alt="" /><noscript class=""><img class="img sd-66" src="https://storage.googleapis.com/studio-design-asset-files/projects/65qmDLXROV/s-520x520_webp_5e042ebf-bd2c-43a6-826a-caa22d852c23.webp" alt="" width="520" height="520" loading="lazy" /></noscript></div><h3 class="text sd-67 theme-5286a3a1">自分にフィットした理想の働き方が叶う</h3></div><p class="text sd-68 theme-429a329a">育児との両立や年収アップなど、中長期視点で"自分にフィットした働き方"を一緒に描きます。</p></div></div></div></div></div><div class="box sd-69"><div class="box sd-70"><h4 class="text sd-71 theme-79b58953">VOICE</h4><h2 class="text sd-72 theme-dcb91420">受講生からの嬉しいお声</h2></div><div class="box sd-73"><div class="box sd-74"><li class="box sd-75"><div class="box sd-76"><div class="box sd-77"><div class="box image image--horizontal sd-78" style="--img-origin:url(https://storage.googleapis.com/studio-design-asset-files/projects/65qmDLXROV/s-320x320_webp_7a595282-0e2d-4b4e-8833-7d7ad1687ba8.webp);--img-small:url(https://storage.googleapis.com/studio-design-asset-files/projects/65qmDLXROV/s-320x320_webp_7a595282-0e2d-4b4e-8833-7d7ad1687ba8.webp);--img-middle:url(https://storage.googleapis.com/studio-design-asset-files/projects/65qmDLXROV/s-320x320_webp_7a595282-0e2d-4b4e-8833-7d7ad1687ba8.webp);--img-regular:url(https://storage.googleapis.com/studio-design-asset-files/projects/65qmDLXROV/s-320x320_webp_7a595282-0e2d-4b4e-8833-7d7ad1687ba8.webp)"><span class="image__bg-container" aria-hidden="true"></span></div></div><div class="box sd-79"><h3 class="text sd-80 theme-5286a3a1">はじめての転職活動をスムーズに行えたのは「自己分析」のおかげ</h3></div></div><p class="text sd-81 theme-23a89b07">もともとは現職を継続しながら副業で自分のやりたいことを深めていこうと考えていたのですが、プログラムを通してキャリアの方向性が決まり、転職を決意！そして「好き」と「できる」を活かせる仕事への転職が決まりました。</p></li><li class="box sd-82"><div class="box sd-83"><div class="box sd-84"><div class="box image image--horizontal sd-85" style="--img-origin:url(https://storage.googleapis.com/studio-design-asset-files/projects/65qmDLXROV/s-320x320_webp_3cb0f285-5250-49a3-9525-e29fc308968e.webp);--img-small:url(https://storage.googleapis.com/studio-design-asset-files/projects/65qmDLXROV/s-320x320_webp_3cb0f285-5250-49a3-9525-e29fc308968e.webp);--img-middle:url(https://storage.googleapis.com/studio-design-asset-files/projects/65qmDLXROV/s-320x320_webp_3cb0f285-5250-49a3-9525-e29fc308968e.webp);--img-regular:url(https://storage.googleapis.com/studio-design-asset-files/projects/65qmDLXROV/s-320x320_webp_3cb0f285-5250-49a3-9525-e29fc308968e.webp)"><span class="image__bg-container" aria-hidden="true"></span></div></div><div class="box sd-86"><h3 class="text sd-87 theme-5286a3a1">自己分析を通して仕事・職場環境へのフィット感がわかった</h3></div></div><p class="text sd-88 theme-23a89b07">転職活動は順調に書類は通過するが、面接で通らないことが多く、ずっとどん底に落とされた気分でした。そこからプログラムを通して「自分のやりたい仕事」と「自分が望む働き方・条件」を知り、両方に合致した企業から内定を獲得！本当に感謝です。</p></li></div><div class="box sd-89"><li class="box sd-90"><div class="box sd-91"><div class="box sd-92"><div class="box image image--horizontal sd-93" style="--img-origin:url(https://storage.googleapis.com/studio-design-asset-files/projects/65qmDLXROV/s-320x320_webp_6895fb70-25b4-4c2b-bb60-614ab8ec2948.webp);--img-small:url(https://storage.googleapis.com/studio-design-asset-files/projects/65qmDLXROV/s-320x320_webp_6895fb70-25b4-4c2b-bb60-614ab8ec2948.webp);--img-middle:url(https://storage.googleapis.com/studio-design-asset-files/projects/65qmDLXROV/s-320x320_webp_6895fb70-25b4-4c2b-bb60-614ab8ec2948.webp);--img-regular:url(https://storage.googleapis.com/studio-design-asset-files/projects/65qmDLXROV/s-320x320_webp_6895fb70-25b4-4c2b-bb60-614ab8ec2948.webp)"><span class="image__bg-container" aria-hidden="true"></span></div></div><div class="box sd-94"><h3 class="text sd-95 theme-5286a3a1">強みを活かせる職種がわかり活躍する姿がイメージできた</h3></div></div><p class="text sd-96 theme-23a89b07">ワークで自分が持っている強みがわかり、それを活かせる職種にたどり着いたら、「こういう会社でこういう役割を担えたら、力が発揮できそうだ」って活躍するイメージができたので納得感がありました。第3者の視点、特に、いろんな人のキャリアを見てきたプロからの言葉にはすごく説得力がありましたね。</p></li><li class="box sd-97"><div class="box sd-98"><div class="box sd-99"><div class="box image image--horizontal sd-100" style="--img-origin:url(https://storage.googleapis.com/studio-design-asset-files/projects/65qmDLXROV/s-320x320_webp_3059cd64-2460-452d-9b62-0c3a222c36ff.webp);--img-small:url(https://storage.googleapis.com/studio-design-asset-files/projects/65qmDLXROV/s-320x320_webp_3059cd64-2460-452d-9b62-0c3a222c36ff.webp);--img-middle:url(https://storage.googleapis.com/studio-design-asset-files/projects/65qmDLXROV/s-320x320_webp_3059cd64-2460-452d-9b62-0c3a222c36ff.webp);--img-regular:url(https://storage.googleapis.com/studio-design-asset-files/projects/65qmDLXROV/s-320x320_webp_3059cd64-2460-452d-9b62-0c3a222c36ff.webp)"><span class="image__bg-container" aria-hidden="true"></span></div></div><div class="box sd-101"><h3 class="text sd-102 theme-5286a3a1">ワークを通して自分自身を徹底的に理解。次のキャリア選択に必要な軸ができた</h3></div></div><p class="text sd-103 theme-23a89b07">強みって自分ではなかなか評価が難しくて、「これを強みと言って良いのか」という不安もあったんですが、担当のキャリアプランナーさんから「これも強みですよ」と第三者視点でたくさんコメントをもらえたので、自信になりました。</p></li></div></div><a class="box sd-104" href="/voice"><p class="text sd-105 theme-86bc47f7">ユーザーインタビューを見る</p><span class="icon sd-106 material-icons">keyboard_arrow_right</span></a></div></div><div class="box sd-107" id="service"><div class="box sd-108"><div class="box sd-109"><div class="box sd-110"><h4 class="text sd-111 theme-79b58953">SERVICE</h4><h2 class="text sd-112 theme-dcb91420">ミートキャリアで描く<br>ライフとキャリアの道しるべ<br></h2></div></div><div class="box sd-113"><div class="box sd-114"><div class="box sd-115"><div class="box image image--horizontal sd-116" style="--img-origin:url(https://storage.googleapis.com/studio-design-asset-files/projects/65qmDLXROV/s-900x600_v-fs_webp_4cd024bc-ff51-4d6d-a0eb-56c940f4fbfb.webp);--img-small:url(https://storage.googleapis.com/studio-design-asset-files/projects/65qmDLXROV/s-900x600_v-fs_webp_4cd024bc-ff51-4d6d-a0eb-56c940f4fbfb_small.webp);--img-middle:url(https://storage.googleapis.com/studio-design-asset-files/projects/65qmDLXROV/s-900x600_v-fs_webp_4cd024bc-ff51-4d6d-a0eb-56c940f4fbfb.webp);--img-regular:url(https://storage.googleapis.com/studio-design-asset-files/projects/65qmDLXROV/s-900x600_v-fs_webp_4cd024bc-ff51-4d6d-a0eb-56c940f4fbfb.webp)"><span class="image__bg-container" aria-hidden="true"></span></div></div><div class="box sd-117"><div class="box sd-118"><p class="text sd-119">01.</p><h3 class="text sd-120 theme-5286a3a1">これまでの経験やスキルだけではなく、あなたの特性・あなたらしさを上手に活かす</h3></div><p class="text sd-121 theme-429a329a">これまでの経験やスキルを中心にキャリアを考えるとうまくいかないこともあります。あなたの生まれ持った資質（性格）や価値観といった特性を理解し、強みを活かせる場所がわかることで、納得のいくキャリアを歩むことができます。</p></div></div><div class="box sd-122"><div class="box sd-123"><img class="img sd-124" width="926" height="456" src="data:image/svg+xml;utf8,&lt;svg xmlns=&#x27;http://www.w3.org/2000/svg&#x27; width=&#x27;926&#x27; height=&#x27;456&#x27; viewBox=&#x27;0 0 926 456&#x27;&gt;&lt;/svg&gt;" data-sd-img="" data-sd-img-src="https://storage.googleapis.com/studio-design-asset-files/projects/65qmDLXROV/s-926x456_v-fs_webp_16bf1232-0dbe-41f8-8bab-25d8f9d30652.png" data-sd-img-w="926" data-sd-img-h="456" data-sd-img-v="fs" data-sd-img-webp="" alt="" /><noscript class=""><img class="img sd-124" src="https://storage.googleapis.com/studio-design-asset-files/projects/65qmDLXROV/s-926x456_v-fs_webp_16bf1232-0dbe-41f8-8bab-25d8f9d30652_small.webp" alt="" width="926" height="456" loading="lazy" /></noscript></div><div class="box sd-125"><div class="box sd-126"><p class="text sd-127">02.</p><h3 class="text sd-128 theme-5286a3a1">内省や言語化をオリジナルワークでフォロー</h3></div><p class="text sd-129 theme-429a329a">国家資格キャリアコンサルタント監修のもと、6,000件以上のキャリア支援を通じて培ったノウハウを凝縮し、内省や言語化が得意ではない方も取り組みやすい工夫を取り入れています。<br></p><a class="box sd-130" href="/service"><p class="text sd-131 theme-86bc47f7">キャリアプログラムの内容</p><span class="icon sd-132 material-icons">keyboard_arrow_right</span></a></div></div><div class="box sd-133"><div class="box sd-134"><img class="img sd-135" width="1000" height="380" src="data:image/svg+xml;utf8,&lt;svg xmlns=&#x27;http://www.w3.org/2000/svg&#x27; width=&#x27;1000&#x27; height=&#x27;380&#x27; viewBox=&#x27;0 0 1000 380&#x27;&gt;&lt;/svg&gt;" data-sd-img="" data-sd-img-src="https://storage.googleapis.com/studio-design-asset-files/projects/65qmDLXROV/s-1000x380_v-fs_webp_2e663569-9e86-47f7-91c1-61bbdd4ddcd9.png" data-sd-img-w="1000" data-sd-img-h="380" data-sd-img-v="fs" data-sd-img-webp="" alt="" /><noscript class=""><img class="img sd-135" src="https://storage.googleapis.com/studio-design-asset-files/projects/65qmDLXROV/s-1000x380_v-fs_webp_2e663569-9e86-47f7-91c1-61bbdd4ddcd9_small.webp" alt="" width="1000" height="380" loading="lazy" /></noscript></div><div class="box sd-136"><div class="box sd-137"><p class="text sd-138">03.</p><h3 class="text sd-139 theme-5286a3a1">経験豊富なキャリアトレーナーが寄り添いマンツーマンでサポートいたします</h3></div><p class="text sd-140 theme-429a329a">経験豊富なキャリアトレーナーが、原体験も活かしながら、あなたの強みやあなたらしさを引き出すお手伝いをさせていただきます。自分の可能性を信じて一歩踏みだす、背中の後押しをさせていただきます。</p></div></div></div></div></div><div class="box symbol-2" data-scope-2><div class="box symbol-2__sd-1"><h4 class="text symbol-2__sd-2 theme-79b58953">CAREER TRAINER</h4><h2 class="text symbol-2__sd-3 theme-dcb91420">あなたに寄り添う<br>キャリアトレーナー陣</h2></div><sd-carousel class="box symbol-2__sd-4" data-type="carousel" data-animate-duration="600" data-interval-duration="5000" data-autoplay data-max-length="7"><template class="sd-carousel__template"><div class="sd-carousel__slide box symbol-2__sd-4__content" data-scope-3 data-appear-manual=""><div class="box symbol-2__sd-4__content__sd-1"><div class="box image image--horizontal symbol-2__sd-4__content__sd-2" style="--img-origin:url(https://storage.googleapis.com/studio-cms-assets/projects/65qmDLXROV/s-1200x800_v-fms_webp_df75c9cd-ca63-454a-bba5-b677335f0068.webp);--img-small:url(https://storage.googleapis.com/studio-cms-assets/projects/65qmDLXROV/s-1200x800_v-fms_webp_df75c9cd-ca63-454a-bba5-b677335f0068_small.webp);--img-middle:url(https://storage.googleapis.com/studio-cms-assets/projects/65qmDLXROV/s-1200x800_v-fms_webp_df75c9cd-ca63-454a-bba5-b677335f0068_middle.webp);--img-regular:url(https://storage.googleapis.com/studio-cms-assets/projects/65qmDLXROV/s-1200x800_v-fms_webp_df75c9cd-ca63-454a-bba5-b677335f0068.webp)"><span class="image__bg-container" aria-hidden="true"></span></div><div class="box symbol-2__sd-4__content__sd-3"><div class="box symbol-2__sd-4__content__sd-4"><div class="box symbol-2__sd-4__content__sd-5"><h3 class="text symbol-2__sd-4__content__sd-6 theme-5286a3a1">永井 万依子</h3><p class="text symbol-2__sd-4__content__sd-7 theme-23a89b07">Maiko Nagai</p></div><p class="text symbol-2__sd-4__content__sd-8 theme-23a89b07">特性や環境、価値観を一緒に見つめながら、安心して自分らしい選択ができるよう伴走します。</p></div><a class="box symbol-2__sd-4__content__sd-9" href="/members/maiko-nagai"><p class="text symbol-2__sd-4__content__sd-10 theme-429a329a">詳しく見る</p><span class="icon symbol-2__sd-4__content__sd-11 material-icons">keyboard_arrow_right</span></a></div></div></div><div class="sd-carousel__slide box symbol-2__sd-4__content" data-scope-4 data-appear-manual=""><div class="box symbol-2__sd-4__content__sd-1"><div class="box image image--horizontal symbol-2__sd-4__content__sd-2" style="--img-origin:url(https://storage.googleapis.com/studio-cms-assets/projects/65qmDLXROV/s-1200x800_v-fms_webp_8097a27a-93a0-4da7-b4c3-4a642437ec16.webp);--img-small:url(https://storage.googleapis.com/studio-cms-assets/projects/65qmDLXROV/s-1200x800_v-fms_webp_8097a27a-93a0-4da7-b4c3-4a642437ec16_small.webp);--img-middle:url(https://storage.googleapis.com/studio-cms-assets/projects/65qmDLXROV/s-1200x800_v-fms_webp_8097a27a-93a0-4da7-b4c3-4a642437ec16_middle.webp);--img-regular:url(https://storage.googleapis.com/studio-cms-assets/projects/65qmDLXROV/s-1200x800_v-fms_webp_8097a27a-93a0-4da7-b4c3-4a642437ec16.webp)"><span class="image__bg-container" aria-hidden="true"></span></div><div class="box symbol-2__sd-4__content__sd-3"><div class="box symbol-2__sd-4__content__sd-4"><div class="box symbol-2__sd-4__content__sd-5"><h3 class="text symbol-2__sd-4__content__sd-6 theme-5286a3a1">池田 由希恵</h3><p class="text symbol-2__sd-4__content__sd-7 theme-23a89b07">Yukie Ikeda</p></div><p class="text symbol-2__sd-4__content__sd-8 theme-23a89b07">強みや価値観を言語化し、納得感のある一歩を踏み出せるようサポートします。</p></div><a class="box symbol-2__sd-4__content__sd-9" href="/members/yukie-ikeda"><p class="text symbol-2__sd-4__content__sd-10 theme-429a329a">詳しく見る</p><span class="icon symbol-2__sd-4__content__sd-11 material-icons">keyboard_arrow_right</span></a></div></div></div><div class="sd-carousel__slide box symbol-2__sd-4__content" data-scope-5 data-appear-manual=""><div class="box symbol-2__sd-4__content__sd-1"><div class="box image image--horizontal symbol-2__sd-4__content__sd-2" style="--img-origin:url(https://storage.googleapis.com/studio-cms-assets/projects/65qmDLXROV/s-1200x800_v-fms_webp_4d809960-cd2e-437c-9299-7f85bcd0d229.webp);--img-small:url(https://storage.googleapis.com/studio-cms-assets/projects/65qmDLXROV/s-1200x800_v-fms_webp_4d809960-cd2e-437c-9299-7f85bcd0d229_small.webp);--img-middle:url(https://storage.googleapis.com/studio-cms-assets/projects/65qmDLXROV/s-1200x800_v-fms_webp_4d809960-cd2e-437c-9299-7f85bcd0d229_middle.webp);--img-regular:url(https://storage.googleapis.com/studio-cms-assets/projects/65qmDLXROV/s-1200x800_v-fms_webp_4d809960-cd2e-437c-9299-7f85bcd0d229.webp)"><span class="image__bg-container" aria-hidden="true"></span></div><div class="box symbol-2__sd-4__content__sd-3"><div class="box symbol-2__sd-4__content__sd-4"><div class="box symbol-2__sd-4__content__sd-5"><h3 class="text symbol-2__sd-4__content__sd-6 theme-5286a3a1">成田 未来</h3><p class="text symbol-2__sd-4__content__sd-7 theme-23a89b07">Miki Narita</p></div><p class="text symbol-2__sd-4__content__sd-8 theme-23a89b07">今の自分に納得感が持てて、「私はこれでいいんだ」と思えるように支援します。</p></div><a class="box symbol-2__sd-4__content__sd-9" href="/members/miki-narita"><p class="text symbol-2__sd-4__content__sd-10 theme-429a329a">詳しく見る</p><span class="icon symbol-2__sd-4__content__sd-11 material-icons">keyboard_arrow_right</span></a></div></div></div><div class="sd-carousel__slide box symbol-2__sd-4__content" data-scope-6 data-appear-manual=""><div class="box symbol-2__sd-4__content__sd-1"><div class="box image image--horizontal symbol-2__sd-4__content__sd-2" style="--img-origin:url(https://storage.googleapis.com/studio-cms-assets/projects/65qmDLXROV/s-1200x800_v-fms_webp_ea851952-8d97-4580-a95c-fc9276e34ed4.webp);--img-small:url(https://storage.googleapis.com/studio-cms-assets/projects/65qmDLXROV/s-1200x800_v-fms_webp_ea851952-8d97-4580-a95c-fc9276e34ed4_small.webp);--img-middle:url(https://storage.googleapis.com/studio-cms-assets/projects/65qmDLXROV/s-1200x800_v-fms_webp_ea851952-8d97-4580-a95c-fc9276e34ed4_middle.webp);--img-regular:url(https://storage.googleapis.com/studio-cms-assets/projects/65qmDLXROV/s-1200x800_v-fms_webp_ea851952-8d97-4580-a95c-fc9276e34ed4.webp)"><span class="image__bg-container" aria-hidden="true"></span></div><div class="box symbol-2__sd-4__content__sd-3"><div class="box symbol-2__sd-4__content__sd-4"><div class="box symbol-2__sd-4__content__sd-5"><h3 class="text symbol-2__sd-4__content__sd-6 theme-5286a3a1">潤間 築</h3><p class="text symbol-2__sd-4__content__sd-7 theme-23a89b07">Kizuku Uruma</p></div><p class="text symbol-2__sd-4__content__sd-8 theme-23a89b07">「自分は何を叶えたいのか」「どんな強みを活かせるのか」を一緒に言語化していきましょう。</p></div><a class="box symbol-2__sd-4__content__sd-9" href="/members/kizuku-uruma"><p class="text symbol-2__sd-4__content__sd-10 theme-429a329a">詳しく見る</p><span class="icon symbol-2__sd-4__content__sd-11 material-icons">keyboard_arrow_right</span></a></div></div></div><div class="sd-carousel__slide box symbol-2__sd-4__content" data-scope-7 data-appear-manual=""><div class="box symbol-2__sd-4__content__sd-1"><div class="box image image--horizontal symbol-2__sd-4__content__sd-2" style="--img-origin:url(https://storage.googleapis.com/studio-cms-assets/projects/65qmDLXROV/s-1200x800_v-fms_webp_4e3aaaec-ff4f-4399-9a6b-00fc6742bf3c.webp);--img-small:url(https://storage.googleapis.com/studio-cms-assets/projects/65qmDLXROV/s-1200x800_v-fms_webp_4e3aaaec-ff4f-4399-9a6b-00fc6742bf3c_small.webp);--img-middle:url(https://storage.googleapis.com/studio-cms-assets/projects/65qmDLXROV/s-1200x800_v-fms_webp_4e3aaaec-ff4f-4399-9a6b-00fc6742bf3c_middle.webp);--img-regular:url(https://storage.googleapis.com/studio-cms-assets/projects/65qmDLXROV/s-1200x800_v-fms_webp_4e3aaaec-ff4f-4399-9a6b-00fc6742bf3c.webp)"><span class="image__bg-container" aria-hidden="true"></span></div><div class="box symbol-2__sd-4__content__sd-3"><div class="box symbol-2__sd-4__content__sd-4"><div class="box symbol-2__sd-4__content__sd-5"><h3 class="text symbol-2__sd-4__content__sd-6 theme-5286a3a1">滝口 沙都子</h3><p class="text symbol-2__sd-4__content__sd-7 theme-23a89b07">Satoko Takiguchi</p></div><p class="text symbol-2__sd-4__content__sd-8 theme-23a89b07">自分らしくありたい姿を描き、その実現に向けて一歩踏み出すための支援をします。</p></div><a class="box symbol-2__sd-4__content__sd-9" href="/members/satoko-takiguchi"><p class="text symbol-2__sd-4__content__sd-10 theme-429a329a">詳しく見る</p><span class="icon symbol-2__sd-4__content__sd-11 material-icons">keyboard_arrow_right</span></a></div></div></div></template></sd-carousel><a class="box symbol-2__sd-17" href="/members"><p class="text symbol-2__sd-18 theme-86bc47f7">キャリアトレーナー紹介</p><span class="icon symbol-2__sd-19 material-icons">keyboard_arrow_right</span></a></div><div class="box sd-141" id="course"><div class="box sd-142"><h4 class="text sd-143 theme-79b58953">COURSE</h4><h2 class="text sd-144 theme-dcb91420">お悩みに合わせて選べるコース</h2></div><div class="box sd-145"><div class="box sd-146"><div class="box sd-147"><div class="box sd-148"><div class="box sd-149"><h2 class="text sd-150 theme-dcb91420">キャリアプランニングコース</h2></div><div class="box sd-151"><div class="box sd-152"><h3 class="text sd-153 theme-5286a3a1">じっくり自己分析から始める<br>キャリアの土台を築く60日コース<br></h3><p class="text sd-154 theme-e1b0171c">「自分にあった仕事や環境を特定したい」「キャリアプランを立てたい」という方にオススメです。価値観の整理からじっくり自己分析を行い、キャリアの方向性を整理していきます。</p></div><div class="box sd-155"><div class="box sd-156"><div class="box sd-157"><span class="icon sd-158 fa-solid fa-yen-sign"></span><p class="text sd-159">月額16,500円〜</p></div><p class="text sd-160">（入会金 55,000円）</p></div><div class="box sd-161"><p class="text sd-162 theme-23a89b07">※表記はすべて税込の金額となります。<br></p><p class="text sd-163 theme-23a89b07">※月額料金は24回払いの場合。一括払いは税込385,000円となります。</p></div></div><a class="text sd-164 theme-86bc47f7" href="/service#course-1">詳しくはこちら</a></div></div></div><div class="box sd-165"><div class="box sd-166"><div class="box sd-167"><h2 class="text sd-168 theme-dcb91420">転職対策コース</h2></div><div class="box sd-169"><div class="box sd-170"><h3 class="text sd-171 theme-5286a3a1">強みを活かした転職活動を<br>強化するための60日コース<br></h3><p class="text sd-172 theme-e1b0171c">「転職活動が思うようにいかない」「強みを活かした転職活動をしたい」という方にオススメのコースです。強みを抽出・言語化し、伝わる自己PRづくりを行います。<br></p></div><div class="box sd-173"><div class="box sd-174"><div class="box sd-175"><span class="icon sd-176 fa-solid fa-yen-sign"></span><p class="text sd-177">月額16,500円〜</p></div><p class="text sd-178">（入会金 55,000円）</p></div><div class="box sd-179"><p class="text sd-180 theme-23a89b07">※表記はすべて税込の金額となります。<br></p><p class="text sd-181 theme-23a89b07">※月額料金は24回払いの場合。一括払いは税込385,000円となります。</p></div></div><a class="text sd-182 theme-86bc47f7" href="/service#course-2">詳しくはこちら</a></div></div></div></div></div><a class="box sd-183" href="/service"><p class="text sd-184 theme-86bc47f7">コース詳細はこちら</p><span class="icon sd-185 material-icons">keyboard_arrow_right</span></a></div><div class="box sd-186" id="media"><div class="box sd-187"><h4 class="text sd-188 theme-79b58953">MEDIA</h4><h2 class="text sd-189 theme-dcb91420">掲載メディア</h2></div><div class="box sd-190"><img class="img sd-191" width="654" height="200" src="data:image/svg+xml;utf8,&lt;svg xmlns=&#x27;http://www.w3.org/2000/svg&#x27; width=&#x27;654&#x27; height=&#x27;200&#x27; viewBox=&#x27;0 0 654 200&#x27;&gt;&lt;/svg&gt;" data-sd-img="" data-sd-img-src="https://storage.googleapis.com/studio-design-asset-files/projects/65qmDLXROV/s-654x200_v-fs_webp_db5d6e2c-aa95-4fb4-aacf-c75ca9e9ddad.png" data-sd-img-w="654" data-sd-img-h="200" data-sd-img-v="fs" data-sd-img-webp="" alt="" /><noscript class=""><img class="img sd-191" src="https://storage.googleapis.com/studio-design-asset-files/projects/65qmDLXROV/s-654x200_v-fs_webp_db5d6e2c-aa95-4fb4-aacf-c75ca9e9ddad_small.webp" alt="" width="654" height="200" loading="lazy" /></noscript><img class="img sd-192" width="370" height="200" src="data:image/svg+xml;utf8,&lt;svg xmlns=&#x27;http://www.w3.org/2000/svg&#x27; width=&#x27;370&#x27; height=&#x27;200&#x27; viewBox=&#x27;0 0 370 200&#x27;&gt;&lt;/svg&gt;" data-sd-img="" data-sd-img-src="https://storage.googleapis.com/studio-design-asset-files/projects/65qmDLXROV/s-370x200_webp_2d9f6a4e-9c9f-4b57-8b78-9083b158d655.png" data-sd-img-w="370" data-sd-img-h="200" data-sd-img-v="" data-sd-img-webp="" alt="" /><noscript class=""><img class="img sd-192" src="https://storage.googleapis.com/studio-design-asset-files/projects/65qmDLXROV/s-370x200_webp_2d9f6a4e-9c9f-4b57-8b78-9083b158d655.webp" alt="" width="370" height="200" loading="lazy" /></noscript><img class="img sd-193" width="521" height="200" src="data:image/svg+xml;utf8,&lt;svg xmlns=&#x27;http://www.w3.org/2000/svg&#x27; width=&#x27;521&#x27; height=&#x27;200&#x27; viewBox=&#x27;0 0 521 200&#x27;&gt;&lt;/svg&gt;" data-sd-img="" data-sd-img-src="https://storage.googleapis.com/studio-design-asset-files/projects/65qmDLXROV/s-521x200_webp_e4c4e5f3-7076-4663-82d4-b2e04813103e.png" data-sd-img-w="521" data-sd-img-h="200" data-sd-img-v="" data-sd-img-webp="" alt="" /><noscript class=""><img class="img sd-193" src="https://storage.googleapis.com/studio-design-asset-files/projects/65qmDLXROV/s-521x200_webp_e4c4e5f3-7076-4663-82d4-b2e04813103e.webp" alt="" width="521" height="200" loading="lazy" /></noscript><img class="img sd-194" width="530" height="232" src="data:image/svg+xml;utf8,&lt;svg xmlns=&#x27;http://www.w3.org/2000/svg&#x27; width=&#x27;530&#x27; height=&#x27;232&#x27; viewBox=&#x27;0 0 530 232&#x27;&gt;&lt;/svg&gt;" data-sd-img="" data-sd-img-src="https://storage.googleapis.com/studio-design-asset-files/projects/65qmDLXROV/s-530x232_webp_d9140b10-48bb-4e9b-9abd-031c2f429684.png" data-sd-img-w="530" data-sd-img-h="232" data-sd-img-v="" data-sd-img-webp="" alt="" /><noscript class=""><img class="img sd-194" src="https://storage.googleapis.com/studio-design-asset-files/projects/65qmDLXROV/s-530x232_webp_d9140b10-48bb-4e9b-9abd-031c2f429684.webp" alt="" width="530" height="232" loading="lazy" /></noscript><img class="img sd-195" width="309" height="200" src="data:image/svg+xml;utf8,&lt;svg xmlns=&#x27;http://www.w3.org/2000/svg&#x27; width=&#x27;309&#x27; height=&#x27;200&#x27; viewBox=&#x27;0 0 309 200&#x27;&gt;&lt;/svg&gt;" data-sd-img="" data-sd-img-src="https://storage.googleapis.com/studio-design-asset-files/projects/65qmDLXROV/s-309x200_webp_e9f056fe-625c-48e9-ae16-5aab429afb8b.png" data-sd-img-w="309" data-sd-img-h="200" data-sd-img-v="" data-sd-img-webp="" alt="" /><noscript class=""><img class="img sd-195" src="https://storage.googleapis.com/studio-design-asset-files/projects/65qmDLXROV/s-309x200_webp_e9f056fe-625c-48e9-ae16-5aab429afb8b.webp" alt="" width="309" height="200" loading="lazy" /></noscript><img class="img sd-196" width="339" height="200" src="data:image/svg+xml;utf8,&lt;svg xmlns=&#x27;http://www.w3.org/2000/svg&#x27; width=&#x27;339&#x27; height=&#x27;200&#x27; viewBox=&#x27;0 0 339 200&#x27;&gt;&lt;/svg&gt;" data-sd-img="" data-sd-img-src="https://storage.googleapis.com/studio-design-asset-files/projects/65qmDLXROV/s-339x200_webp_b93664b5-337f-44cf-879b-7310311e452a.png" data-sd-img-w="339" data-sd-img-h="200" data-sd-img-v="" data-sd-img-webp="" alt="" /><noscript class=""><img class="img sd-196" src="https://storage.googleapis.com/studio-design-asset-files/projects/65qmDLXROV/s-339x200_webp_b93664b5-337f-44cf-879b-7310311e452a.webp" alt="" width="339" height="200" loading="lazy" /></noscript><img class="img sd-197" width="520" height="133" src="data:image/svg+xml;utf8,&lt;svg xmlns=&#x27;http://www.w3.org/2000/svg&#x27; width=&#x27;520&#x27; height=&#x27;133&#x27; viewBox=&#x27;0 0 520 133&#x27;&gt;&lt;/svg&gt;" data-sd-img="" data-sd-img-src="https://storage.googleapis.com/studio-design-asset-files/projects/65qmDLXROV/s-520x133_webp_a0e20b7b-69d2-4642-ab16-6b921bc84d2a.png" data-sd-img-w="520" data-sd-img-h="133" data-sd-img-v="" data-sd-img-webp="" alt="" /><noscript class=""><img class="img sd-197" src="https://storage.googleapis.com/studio-design-asset-files/projects/65qmDLXROV/s-520x133_webp_a0e20b7b-69d2-4642-ab16-6b921bc84d2a.webp" alt="" width="520" height="133" loading="lazy" /></noscript><img class="img sd-198" width="480" height="240" src="data:image/svg+xml;utf8,&lt;svg xmlns=&#x27;http://www.w3.org/2000/svg&#x27; width=&#x27;480&#x27; height=&#x27;240&#x27; viewBox=&#x27;0 0 480 240&#x27;&gt;&lt;/svg&gt;" data-sd-img="" data-sd-img-src="https://storage.googleapis.com/studio-design-asset-files/projects/65qmDLXROV/s-480x240_webp_e98cf2e8-8ea0-40c9-b29e-08e8597d0539.png" data-sd-img-w="480" data-sd-img-h="240" data-sd-img-v="" data-sd-img-webp="" alt="" /><noscript class=""><img class="img sd-198" src="https://storage.googleapis.com/studio-design-asset-files/projects/65qmDLXROV/s-480x240_webp_e98cf2e8-8ea0-40c9-b29e-08e8597d0539.webp" alt="" width="480" height="240" loading="lazy" /></noscript><img class="img sd-199" width="480" height="144" src="data:image/svg+xml;utf8,&lt;svg xmlns=&#x27;http://www.w3.org/2000/svg&#x27; width=&#x27;480&#x27; height=&#x27;144&#x27; viewBox=&#x27;0 0 480 144&#x27;&gt;&lt;/svg&gt;" data-sd-img="" data-sd-img-src="https://storage.googleapis.com/studio-design-asset-files/projects/65qmDLXROV/s-480x144_webp_a3cefe8e-bef0-4935-8240-d318aebb3be5.png" data-sd-img-w="480" data-sd-img-h="144" data-sd-img-v="" data-sd-img-webp="" alt="" /><noscript class=""><img class="img sd-199" src="https://storage.googleapis.com/studio-design-asset-files/projects/65qmDLXROV/s-480x144_webp_a3cefe8e-bef0-4935-8240-d318aebb3be5.webp" alt="" width="480" height="144" loading="lazy" /></noscript></div></div><div class="box symbol-3" data-scope-8><div class="box image image--horizontal symbol-3__sd-1" style="--img-origin:url(https://storage.googleapis.com/studio-design-asset-files/projects/65qmDLXROV/s-6240x4160_v-frms_webp_82ebf4e7-6773-4daa-ae91-1412159de6c8.webp);--img-small:url(https://storage.googleapis.com/studio-design-asset-files/projects/65qmDLXROV/s-6240x4160_v-frms_webp_82ebf4e7-6773-4daa-ae91-1412159de6c8_small.webp);--img-middle:url(https://storage.googleapis.com/studio-design-asset-files/projects/65qmDLXROV/s-6240x4160_v-frms_webp_82ebf4e7-6773-4daa-ae91-1412159de6c8_middle.webp);--img-regular:url(https://storage.googleapis.com/studio-design-asset-files/projects/65qmDLXROV/s-6240x4160_v-frms_webp_82ebf4e7-6773-4daa-ae91-1412159de6c8_regular.webp)"><span class="image__bg-container" aria-hidden="true"></span><div class="box symbol-3__sd-2"><div class="box symbol-3__sd-3"><h2 class="text symbol-3__sd-4 theme-dcb91420">3分で、今のキャリアを<br>見つめ直してみませんか？</h2><p class="text symbol-3__sd-5 theme-429a329a">匿名・無料の簡単なワークで、今感じているモヤモヤを"見える化"します。キャリアの気づきの第一歩として、お気軽にお試しください。</p><a class="text symbol-3__sd-6 theme-86bc47f7" href="https://work.meetcareer.net/" target="_blank">まずは気軽に3分ワーク</a></div></div></div></div><div class="box sd-200" id="message"><div class="box sd-201"><h4 class="text sd-202 theme-79b58953">MESSAGE</h4><h2 class="text sd-203 theme-dcb91420">ミートキャリアが伝えたいこと</h2></div><div class="box sd-204"><div class="box sd-205"><div class="box sd-206"><div class="box sd-207"><div class="box sd-208"><div class="box sd-209"><div class="box image image--horizontal sd-210" style="--img-origin:url(https://storage.googleapis.com/studio-design-asset-files/projects/65qmDLXROV/s-400x400_webp_e0d53915-3751-4076-9b11-35f48e75ed12.webp);--img-small:url(https://storage.googleapis.com/studio-design-asset-files/projects/65qmDLXROV/s-400x400_webp_e0d53915-3751-4076-9b11-35f48e75ed12.webp);--img-middle:url(https://storage.googleapis.com/studio-design-asset-files/projects/65qmDLXROV/s-400x400_webp_e0d53915-3751-4076-9b11-35f48e75ed12.webp);--img-regular:url(https://storage.googleapis.com/studio-design-asset-files/projects/65qmDLXROV/s-400x400_webp_e0d53915-3751-4076-9b11-35f48e75ed12.webp)"><span class="image__bg-container" aria-hidden="true"></span></div></div><div class="box sd-211"><p class="text sd-212">ミートキャリア代表</p><div class="box sd-213"><p class="text sd-214">川村 邦光</p><p class="text sd-215">Kunimitsu Kawamura</p></div></div></div><div class="box sd-216"><div class="box sd-217"><div class="box sd-218"><h2 class="text sd-219 theme-5286a3a1">一度しかない人生。自分らしくありたい・生きたい人に、一歩を踏み出してもらいたい</h2></div></div><p class="text sd-220 theme-429a329a">"いくつになっても自分らしく働く"を叶えたい、私たちミートキャリアはそんな想いに寄り添い、キャリアを一緒に考え歩むキャリアのパートナーです。<br>私たちは、誰しも生まれながらに持っている強みを活かすことで、納得のいくキャリア・人生を描くことができると考えています。<br>ライフステージの変化に伴い、キャリアへの向き合い方もより難しくなっていきます。家族のこと、年齢のこと、将来のこと...悩むこと、考えること、心配ごとも増えてきます。価値観も変わってきます。周りを見渡してもロールモデルとなるような人はいない。それでも一度しかない人生、自分らしくありたい・生きたい、そんなあなたの一歩を踏み出すサポートさせていただきます。<br>私たちのビジョンは「自分に合った生き方ができる社会の実現」です。お一人おひとりの課題に向き合い、中長期視点でライフとキャリアに関するお悩みを解決まで支えていきたいと考えています。</p></div></div></div></div><div class="box sd-221"><div class="box sd-222"><div class="box sd-223"><div class="box sd-224"><div class="box sd-225"><div class="box image image--horizontal sd-226" style="--img-origin:url(https://storage.googleapis.com/studio-design-asset-files/projects/65qmDLXROV/s-400x400_webp_ff205281-5369-420d-aee1-4a56fb159b9f.webp);--img-small:url(https://storage.googleapis.com/studio-design-asset-files/projects/65qmDLXROV/s-400x400_webp_ff205281-5369-420d-aee1-4a56fb159b9f.webp);--img-middle:url(https://storage.googleapis.com/studio-design-asset-files/projects/65qmDLXROV/s-400x400_webp_ff205281-5369-420d-aee1-4a56fb159b9f.webp);--img-regular:url(https://storage.googleapis.com/studio-design-asset-files/projects/65qmDLXROV/s-400x400_webp_ff205281-5369-420d-aee1-4a56fb159b9f.webp)"><span class="image__bg-container" aria-hidden="true"></span></div></div><div class="box sd-227"><p class="text sd-228">ファウンダー</p><div class="box sd-229"><p class="text sd-230">喜多村 若菜</p><p class="text sd-231">Wakana Kitamura</p></div></div></div><div class="box sd-232"><div class="box sd-233"><div class="box sd-234"><h2 class="text sd-235 theme-5286a3a1">ミートキャリアは、一人ひとりが叶えたい人生の形を一緒に創っていく存在になる</h2></div></div><p class="text sd-236 theme-429a329a">“「転職」がゴールではない、一人ひとりのキャリアのお悩みのサポートがしたい” <br>これがミートキャリア創業のきっかけです。<br>通常の転職サービスでは、求人のご紹介が仕事なので、中長期のキャリアや個別のお悩みのご相談を受けることは難しいです。転職サービスを活用しても、キャリアの方向性が決まっておらず、求人にピンとこなかった経験がある方も多いと思います。<br>だからこそ、ミートキャリアは、キャリアの方向性を決めるところから伴走します。<br>キャリアはあくまで人生の一部です。<br>ライフを大事にしたい人も、キャリアを頑張りたい人も、両方叶えたい人も、一人ひとりが叶えたい人生の形を一緒に創っていく、そんな存在でありたいと考えています。</p></div></div></div></div></div></div><div class="box symbol-4" data-scope-9><h4 class="text symbol-4__sd-1 theme-79b58953">FAQ</h4><h2 class="text symbol-4__sd-2 theme-dcb91420">よくあるご質問</h2><div class="box symbol-4__sd-3"><div class="box symbol-4__sd-4" id="tab-1"><div class="box symbol-4__sd-5"><a class="box symbol-4__sd-6" href="#tab-1"><div class="box symbol-4__sd-7"><p class="text symbol-4__sd-8">サービスについて</p><span class="icon symbol-4__sd-9 material-icons">keyboard_arrow_down</span></div></a><a class="box symbol-4__sd-10" href="#tab-2"><div class="box symbol-4__sd-11"><p class="text symbol-4__sd-12">お支払いについて</p><span class="icon symbol-4__sd-13 material-icons">keyboard_arrow_down</span></div></a><a class="box symbol-4__sd-14" href="#tab-3"><div class="box symbol-4__sd-15"><p class="text symbol-4__sd-16">各種特典・割引のご案内</p><span class="icon symbol-4__sd-17 material-icons">keyboard_arrow_down</span></div></a><a class="box symbol-4__sd-18" href="#tab-4"><div class="box symbol-4__sd-19"><p class="text symbol-4__sd-20">解約について</p><span class="icon symbol-4__sd-21 material-icons">keyboard_arrow_down</span></div></a></div><div class="box symbol-4__sd-22"><sd-toggle class="toggle symbol-4__sd-23"><button class="box symbol-4__sd-24" data-toggle-trigger="" aria-expanded="false" type="button"><div class="box symbol-4__sd-25"><p class="text symbol-4__sd-26">Q</p><p class="text symbol-4__sd-27">キャリアプログラムとは何ですか？</p></div><span class="icon symbol-4__sd-28 material-icons" aria-hidden="true">keyboard_arrow_up</span></button><div class="box symbol-4__sd-29" data-toggle-content="" aria-hidden="true" inert=""><div class="box symbol-4__sd-30"><p class="text symbol-4__sd-31 theme-429a329a">キャリアに関する不安を解消できるサービスです。詳しくはサービスサイトをご覧ください。</p></div></div></sd-toggle><sd-toggle class="toggle symbol-4__sd-32"><button class="box symbol-4__sd-33" data-toggle-trigger="" aria-expanded="false" type="button"><div class="box symbol-4__sd-34"><p class="text symbol-4__sd-35">Q</p><p class="text symbol-4__sd-36">どういった方が利用していますか？</p></div><span class="icon symbol-4__sd-37 material-icons" aria-hidden="true">keyboard_arrow_up</span></button><div class="box symbol-4__sd-38" data-toggle-content="" aria-hidden="true" inert=""><div class="box symbol-4__sd-39"><p class="text symbol-4__sd-40 theme-429a329a">利用者の8割は30~40代の女性となります。短期的な転職成功ではなく、長い人生の中で一度自分のキャリアについて棚卸して、時間を掛けてでも次のキャリアの軸を決めたい、といった方が多いです。</p></div></div></sd-toggle><sd-toggle class="toggle symbol-4__sd-41"><button class="box symbol-4__sd-42" data-toggle-trigger="" aria-expanded="false" type="button"><div class="box symbol-4__sd-43"><p class="text symbol-4__sd-44">Q</p><p class="text symbol-4__sd-45">どれぐらいのペースで取り組むイメージですか？</p></div><span class="icon symbol-4__sd-46 material-icons" aria-hidden="true">keyboard_arrow_up</span></button><div class="box symbol-4__sd-47" data-toggle-content="" aria-hidden="true" inert=""><div class="box symbol-4__sd-48"><p class="text symbol-4__sd-49 theme-429a329a">週に1回のペースで、ワーク(1時間)とオンラインセッション(50分)を進めていただくイメージです。<br>サポート期間内であれば、受講スピードの調整は柔軟にできますので、担当のキャリアトレーナーまでご相談ください。</p></div></div></sd-toggle><sd-toggle class="toggle symbol-4__sd-50"><button class="box symbol-4__sd-51" data-toggle-trigger="" aria-expanded="false" type="button"><div class="box symbol-4__sd-52"><p class="text symbol-4__sd-53">Q</p><p class="text symbol-4__sd-54">料金はいくらですか？</p></div><span class="icon symbol-4__sd-55 material-icons" aria-hidden="true">keyboard_arrow_up</span></button><div class="box symbol-4__sd-56" data-toggle-content="" aria-hidden="true" inert=""><div class="box symbol-4__sd-57"><p class="text symbol-4__sd-58 theme-429a329a">入会金：¥50,000（税込¥55,000）※入会時のみ<br>・キャリアプランニングコース：¥350,000（税込¥365,000）※一括支払いの場合<br>・転職対策コース：¥350,000（税込¥365,000）※一括支払いの場合<br>・追加コース：¥87,500（税込¥96,250）※一括支払いの場合</p></div></div></sd-toggle><sd-toggle class="toggle symbol-4__sd-59"><button class="box symbol-4__sd-60" data-toggle-trigger="" aria-expanded="false" type="button"><div class="box symbol-4__sd-61"><p class="text symbol-4__sd-62">Q</p><p class="text symbol-4__sd-63">キャリアトレーナーの指名はできますか？</p></div><span class="icon symbol-4__sd-64 material-icons" aria-hidden="true">keyboard_arrow_up</span></button><div class="box symbol-4__sd-65" data-toggle-content="" aria-hidden="true" inert=""><div class="box symbol-4__sd-66"><p class="text symbol-4__sd-67 theme-429a329a">ご指名は承っておりません。お悩み内容や目標に合わせて、最適なキャリアトレーナーをアサインさせていただきます。</p></div></div></sd-toggle><sd-toggle class="toggle symbol-4__sd-68"><button class="box symbol-4__sd-69" data-toggle-trigger="" aria-expanded="false" type="button"><div class="box symbol-4__sd-70"><p class="text symbol-4__sd-71">Q</p><p class="text symbol-4__sd-72">キャリアトレーナーとのコミュニケーションは何で行われますか？</p></div><span class="icon symbol-4__sd-73 material-icons" aria-hidden="true">keyboard_arrow_up</span></button><div class="box symbol-4__sd-74" data-toggle-content="" aria-hidden="true" inert=""><div class="box symbol-4__sd-75"><p class="text symbol-4__sd-76 theme-429a329a">主にメールにてやり取りを行います</p></div></div></sd-toggle><sd-toggle class="toggle symbol-4__sd-77"><button class="box symbol-4__sd-78" data-toggle-trigger="" aria-expanded="false" type="button"><div class="box symbol-4__sd-79"><p class="text symbol-4__sd-80">Q</p><p class="text symbol-4__sd-81">オンラインセッションの頻度はどれぐらいですか？</p></div><span class="icon symbol-4__sd-82 material-icons" aria-hidden="true">keyboard_arrow_up</span></button><div class="box symbol-4__sd-83" data-toggle-content="" aria-hidden="true" inert=""><div class="box symbol-4__sd-84"><p class="text symbol-4__sd-85 theme-429a329a">平均すると週に1回の間隔で行いますが、サポート期間内であれば実施タイミングは自由に決めていただくことができます。</p></div></div></sd-toggle><sd-toggle class="toggle symbol-4__sd-86"><button class="box symbol-4__sd-87" data-toggle-trigger="" aria-expanded="false" type="button"><div class="box symbol-4__sd-88"><p class="text symbol-4__sd-89">Q</p><p class="text symbol-4__sd-90">キャリアプログラムはスマートフォン/タブレットだけで受講できますか？</p></div><span class="icon symbol-4__sd-91 material-icons" aria-hidden="true">keyboard_arrow_up</span></button><div class="box symbol-4__sd-92" data-toggle-content="" aria-hidden="true" inert=""><div class="box symbol-4__sd-93"><p class="text symbol-4__sd-94 theme-429a329a">自己分析ワークはGoogleスプレッドシートで提供しており、タブレットやスマートフォンでもご利用いただけますが、専用のアプリケーションのダウンロード（無料）が必要です。<br><br>オンラインセッションはGoogle Meetを使用します。<br>・周囲が気にならず、安定した通信速度がでる環境にてご参加ください。<br>・お子様同席は全く問題ございません。</p></div></div></sd-toggle></div></div><div class="box symbol-4__sd-95" id="tab-2"><div class="box symbol-4__sd-96"><a class="box symbol-4__sd-97" href="#tab-1"><div class="box symbol-4__sd-98"><p class="text symbol-4__sd-99">サービスについて</p><span class="icon symbol-4__sd-100 material-icons">keyboard_arrow_down</span></div></a><a class="box symbol-4__sd-101" href="#tab-2"><div class="box symbol-4__sd-102"><p class="text symbol-4__sd-103">お支払いについて</p><span class="icon symbol-4__sd-104 material-icons">keyboard_arrow_down</span></div></a><a class="box symbol-4__sd-105" href="#tab-3"><div class="box symbol-4__sd-106"><p class="text symbol-4__sd-107">各種特典・割引のご案内</p><span class="icon symbol-4__sd-108 material-icons">keyboard_arrow_down</span></div></a><a class="box symbol-4__sd-109" href="#tab-4"><div class="box symbol-4__sd-110"><p class="text symbol-4__sd-111">解約について</p><span class="icon symbol-4__sd-112 material-icons">keyboard_arrow_down</span></div></a></div><div class="box symbol-4__sd-113"><sd-toggle class="toggle symbol-4__sd-114"><button class="box symbol-4__sd-115" data-toggle-trigger="" aria-expanded="false" type="button"><div class="box symbol-4__sd-116"><p class="text symbol-4__sd-117">Q</p><p class="text symbol-4__sd-118">お支払い方法は何が使えますか？</p></div><span class="icon symbol-4__sd-119 material-icons" aria-hidden="true">keyboard_arrow_up</span></button><div class="box symbol-4__sd-120" data-toggle-content="" aria-hidden="true" inert=""><div class="box symbol-4__sd-121"><p class="text symbol-4__sd-122 theme-429a329a">一括支払いの場合は、銀行振込またはクレジットカードからお選びいただけます。<br>分割支払いの場合は、クレジットカードのみとなります。</p></div></div></sd-toggle><sd-toggle class="toggle symbol-4__sd-123"><button class="box symbol-4__sd-124" data-toggle-trigger="" aria-expanded="false" type="button"><div class="box symbol-4__sd-125"><p class="text symbol-4__sd-126">Q</p><p class="text symbol-4__sd-127">領収料は発行できますか？</p></div><span class="icon symbol-4__sd-128 material-icons" aria-hidden="true">keyboard_arrow_up</span></button><div class="box symbol-4__sd-129" data-toggle-content="" aria-hidden="true" inert=""><div class="box symbol-4__sd-130"><p class="text symbol-4__sd-131 theme-429a329a">お申し込みいただいた際に、ご登録いただいたメールアドレス宛に領収書をお送りいたします。<br>分割支払いの場合は、毎月お支払いごとにご登録いただいたメールアドレス宛に領収書が届きます。</p></div></div></sd-toggle><sd-toggle class="toggle symbol-4__sd-132"><button class="box symbol-4__sd-133" data-toggle-trigger="" aria-expanded="false" type="button"><div class="box symbol-4__sd-134"><p class="text symbol-4__sd-135">Q</p><p class="text symbol-4__sd-136">分割で支払いはできますか？</p></div><span class="icon symbol-4__sd-137 material-icons" aria-hidden="true">keyboard_arrow_up</span></button><div class="box symbol-4__sd-138" data-toggle-content="" aria-hidden="true" inert=""><div class="box symbol-4__sd-139"><p class="text symbol-4__sd-140 theme-429a329a">分割払いも可能です。詳しい手続きに関しては初回無料カウンセリングでお聞きください。</p></div></div></sd-toggle></div></div><div class="box symbol-4__sd-141" id="tab-3"><div class="box symbol-4__sd-142"><a class="box symbol-4__sd-143" href="#tab-1"><div class="box symbol-4__sd-144"><p class="text symbol-4__sd-145">サービスについて</p><span class="icon symbol-4__sd-146 material-icons">keyboard_arrow_down</span></div></a><a class="box symbol-4__sd-147" href="#tab-2"><div class="box symbol-4__sd-148"><p class="text symbol-4__sd-149">お支払いについて</p><span class="icon symbol-4__sd-150 material-icons">keyboard_arrow_down</span></div></a><a class="box symbol-4__sd-151" href="#tab-3"><div class="box symbol-4__sd-152"><p class="text symbol-4__sd-153">各種特典・割引のご案内</p><span class="icon symbol-4__sd-154 material-icons">keyboard_arrow_down</span></div></a><a class="box symbol-4__sd-155" href="#tab-4"><div class="box symbol-4__sd-156"><p class="text symbol-4__sd-157">解約について</p><span class="icon symbol-4__sd-158 material-icons">keyboard_arrow_down</span></div></a></div><div class="box symbol-4__sd-159"><sd-toggle class="toggle symbol-4__sd-160"><button class="box symbol-4__sd-161" data-toggle-trigger="" aria-expanded="false" type="button"><div class="box symbol-4__sd-162"><p class="text symbol-4__sd-163">Q</p><p class="text symbol-4__sd-164">クーポンなどの割引はありますか？</p></div><span class="icon symbol-4__sd-165 material-icons" aria-hidden="true">keyboard_arrow_up</span></button><div class="box symbol-4__sd-166" data-toggle-content="" aria-hidden="true" inert=""><div class="box symbol-4__sd-167"><p class="text symbol-4__sd-168 theme-429a329a">無料キャリアカウンセリングの中でお伝えさせていただきます。ぜひ、お越しいただければと思います。</p></div></div></sd-toggle></div></div><div class="box symbol-4__sd-169" id="tab-4"><div class="box symbol-4__sd-170"><a class="box symbol-4__sd-171" href="#tab-1"><div class="box symbol-4__sd-172"><p class="text symbol-4__sd-173">サービスについて</p><span class="icon symbol-4__sd-174 material-icons">keyboard_arrow_down</span></div></a><a class="box symbol-4__sd-175" href="#tab-2"><div class="box symbol-4__sd-176"><p class="text symbol-4__sd-177">お支払いについて</p><span class="icon symbol-4__sd-178 material-icons">keyboard_arrow_down</span></div></a><a class="box symbol-4__sd-179" href="#tab-3"><div class="box symbol-4__sd-180"><p class="text symbol-4__sd-181">各種特典・割引のご案内</p><span class="icon symbol-4__sd-182 material-icons">keyboard_arrow_down</span></div></a><a class="box symbol-4__sd-183" href="#tab-4"><div class="box symbol-4__sd-184"><p class="text symbol-4__sd-185">解約について</p><span class="icon symbol-4__sd-186 material-icons">keyboard_arrow_down</span></div></a></div><div class="box symbol-4__sd-187"><sd-toggle class="toggle symbol-4__sd-188"><button class="box symbol-4__sd-189" data-toggle-trigger="" aria-expanded="false" type="button"><div class="box symbol-4__sd-190"><p class="text symbol-4__sd-191">Q</p><p class="text symbol-4__sd-192">休会できますか？</p></div><span class="icon symbol-4__sd-193 material-icons" aria-hidden="true">keyboard_arrow_up</span></button><div class="box symbol-4__sd-194" data-toggle-content="" aria-hidden="true" inert=""><div class="box symbol-4__sd-195"><p class="text symbol-4__sd-196 theme-429a329a">現在、休会制度は設けておりません。</p></div></div></sd-toggle><sd-toggle class="toggle symbol-4__sd-197"><button class="box symbol-4__sd-198" data-toggle-trigger="" aria-expanded="false" type="button"><div class="box symbol-4__sd-199"><p class="text symbol-4__sd-200">Q</p><p class="text symbol-4__sd-201">解約したい場合、どうしたらいいですか？</p></div><span class="icon symbol-4__sd-202 material-icons" aria-hidden="true">keyboard_arrow_up</span></button><div class="box symbol-4__sd-203" data-toggle-content="" aria-hidden="true" inert=""><div class="box symbol-4__sd-204"><p class="text symbol-4__sd-205 theme-429a329a">担当のキャリアトレーナーまでお申し付けください。解約手続きのご案内をさせていただきます。</p></div></div></sd-toggle></div></div></div></div><div class="box sd-237"><div class="box symbol-3" data-scope-10><div class="box image image--horizontal symbol-3__sd-1" style="--img-origin:url(https://storage.googleapis.com/studio-design-asset-files/projects/65qmDLXROV/s-6240x4160_v-frms_webp_82ebf4e7-6773-4daa-ae91-1412159de6c8.webp);--img-small:url(https://storage.googleapis.com/studio-design-asset-files/projects/65qmDLXROV/s-6240x4160_v-frms_webp_82ebf4e7-6773-4daa-ae91-1412159de6c8_small.webp);--img-middle:url(https://storage.googleapis.com/studio-design-asset-files/projects/65qmDLXROV/s-6240x4160_v-frms_webp_82ebf4e7-6773-4daa-ae91-1412159de6c8_middle.webp);--img-regular:url(https://storage.googleapis.com/studio-design-asset-files/projects/65qmDLXROV/s-6240x4160_v-frms_webp_82ebf4e7-6773-4daa-ae91-1412159de6c8_regular.webp)"><span class="image__bg-container" aria-hidden="true"></span><div class="box symbol-3__sd-2"><div class="box symbol-3__sd-3"><h2 class="text symbol-3__sd-4 theme-dcb91420">3分で、今のキャリアを<br>見つめ直してみませんか？</h2><p class="text symbol-3__sd-5 theme-429a329a">匿名・無料の簡単なワークで、今感じているモヤモヤを"見える化"します。キャリアの気づきの第一歩として、お気軽にお試しください。</p><a class="text symbol-3__sd-6 theme-86bc47f7" href="https://work.meetcareer.net/" target="_blank">まずは気軽に3分ワーク</a></div></div></div></div></div></main><footer class="box symbol-5" data-scope-11><div class="box symbol-5__sd-1"><div class="box symbol-5__sd-2"><div class="box symbol-5__sd-3"><a class="text symbol-5__sd-4 theme-23a89b07" href="/company#contact">お問い合わせ</a><a class="text symbol-5__sd-5 theme-23a89b07" href="/company" target="_blank">運営会社</a><a class="text symbol-5__sd-6 theme-23a89b07" href="https://fruor.notion.site/meetcareer-terms" target="_blank">利用規約</a><a class="text symbol-5__sd-7 theme-23a89b07" href="https://fruor.notion.site/9684723a87ca436d8fd46ddbf5f314b5" target="_blank">プライバシーポリシー</a><a class="text symbol-5__sd-8 theme-23a89b07" href="https://fruor.notion.site/0f4d7cacf55d466a960e9f907b2fe64a" target="_blank">特定商取引法に基づく表示</a></div></div><img class="img symbol-5__sd-9" width="214" height="40" alt="" src="https://storage.googleapis.com/studio-design-asset-files/projects/65qmDLXROV/s-214x40_3b3fc86b-5f8e-4c29-a84f-f9c0958dcdf6.svg" loading="lazy" /><p class="text symbol-5__sd-10 theme-23a89b07">© 2025 fruor Inc.</p></div></footer><div class="box symbol-6 appear" data-scope-12><a class="text symbol-6__sd-1" href="https://work.meetcareer.net/" target="_blank">まずは気軽に3分ワーク</a></div></div>

